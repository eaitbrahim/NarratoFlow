# Required only when the channel selects a paid provider of that kind.
NARRATOFLOW_IMAGE_API_KEY=
# ElevenLabs key; edge-tts and piper voices need none.
NARRATOFLOW_VOICE_API_KEY=
NARRATOFLOW_LLM_API_KEY=
# Needed for the default Voyage embeddings; avoid it with `[embed] provider = "ollama"` in channel.toml.
NARRATOFLOW_EMBED_API_KEY=
# Optional
NARRATOFLOW_DATA_DIR=~/.narratoflow
NARRATOFLOW_LOG_LEVEL=INFO
# ffmpeg binary for `render`; it must be built with libass (macOS: brew install ffmpeg-full, then
# NARRATOFLOW_FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg). Default: ffmpeg on PATH.
NARRATOFLOW_FFMPEG=
